APP_NAME=Keschain
APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost/keschainadmin

DB_HOST=localhost
DB_NAME=keschain
DB_USER=root
DB_PASS=

JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRY=3600  # 1 hour
JWT_REFRESH_EXPIRY=2592000  # 30 days

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa

SMS_API_KEY=your_hostpinnacle_key
SMS_SENDER_ID=KesChain

REGISTRATION_FEE_REQUIRED=true
REGISTRATION_FEE=50.00

REFERRAL_LEVEL_1_COMMISSION=30
REFERRAL_LEVEL_2_COMMISSION=15
REFERRAL_LEVEL_3_COMMISSION=10
REFERRAL_LEVEL_4_COMMISSION=5
REFERRAL_LEVEL_5_COMMISSION=2

TASK_REWARD_MIN=5.00
TASK_REWARD_MAX=100.00